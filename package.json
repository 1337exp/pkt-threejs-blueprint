{
  "name": "@1337exp/pkt-threejs-blueprint",
  "version": "0.1.0",
  "description": "The small shared layer our Three.js prototypes keep rewriting: game clock and tweens, springs, seeded random, live-tuning core. Import only what you need.",
  "keywords": [
    "threejs",
    "three",
    "tween",
    "spring",
    "prng",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/1337exp/pkt-threejs-blueprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/pkt-threejs-blueprint.git"
  },
  "bugs": {
    "url": "https://github.com/1337exp/pkt-threejs-blueprint/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    "./ease": {
      "types": "./dist/core/ease.d.ts",
      "import": "./dist/core/ease.js"
    },
    "./ticker": {
      "types": "./dist/core/ticker.d.ts",
      "import": "./dist/core/ticker.js"
    },
    "./spring": {
      "types": "./dist/core/spring.d.ts",
      "import": "./dist/core/spring.js"
    },
    "./rng": {
      "types": "./dist/core/rng.d.ts",
      "import": "./dist/core/rng.js"
    },
    "./tuning": {
      "types": "./dist/core/tuning.d.ts",
      "import": "./dist/core/tuning.js"
    },
    "./loop": {
      "types": "./dist/core/loop.d.ts",
      "import": "./dist/core/loop.js"
    },
    "./renderer": {
      "types": "./dist/three/renderer.d.ts",
      "import": "./dist/three/renderer.js"
    },
    "./pointer": {
      "types": "./dist/three/pointer.d.ts",
      "import": "./dist/three/pointer.js"
    },
    "./dispose": {
      "types": "./dist/three/dispose.d.ts",
      "import": "./dist/three/dispose.js"
    },
    "./vue/tuning-panel": {
      "types": "./dist/components/vue/tuning-panel.d.ts",
      "import": "./dist/components/vue/tuning-panel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "three": ">=0.186.1 <0.188.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.45"
  },
  "author": "1337exp",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
