    // Ядро без DOM и без Node: если проходит здесь, то работает где угодно.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "lib": ["ES2022"],
        "types": []
    },
    "include": ["src/core/**/*.ts"]
}
